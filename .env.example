# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS and redirects)
BASE_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Supabase (for persistent storage - create project at supabase.com)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Admin (use Vercel env vars in production, never commit real password)
ADMIN_PASSWORD=your_admin_password

# Stripe Configuration
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# For production, use:
# STRIPE_SECRET_KEY=sk_live_your_live_key_here

# Lead capture to separate GoHighLevel account/location
LEAD_GHL_API_KEY=your_lead_ghl_api_key_here
LEAD_GHL_LOCATION_ID=your_lead_ghl_location_id_here
# Optional: comma-separated tags and workflow trigger
LEAD_GHL_TAGS=Lead,Spartans Tickets,Homepage Popup
LEAD_GHL_WORKFLOW_ID=your_lead_workflow_id_here
